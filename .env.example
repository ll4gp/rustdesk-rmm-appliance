# ====================================================================
# RustDesk Client-Site Appliance Configuration (.env)
# ====================================================================
SITE_NAME=Client Site Appliance
DASHBOARD_PORT=3031

# Primary LAN IP or DNS hostname of this site server (auto-detected by Deploy-Appliance)
APPLIANCE_HOST=

# Optional Secondary / VPN / Tailscale IP for roaming laptops
APPLIANCE_SECONDARY_HOST=

# Default initial admin password (Username: admin)
ADMIN_INITIAL_PASSWORD=admin123
JWT_SECRET=rustdesk-site-appliance-secret-change-me
